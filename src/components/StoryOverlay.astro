---
import { Image } from 'astro:assets';
import { readingTime, type Post } from '../lib/posts';
import { leadSizes, leadWidths } from '../lib/images';
import { formatDateShort } from '../lib/format';
import { authorBySlug } from '../data/authors';
import CategoryChip from './CategoryChip.astro';

/**
 * Full-bleed lead card: photograph with a gradient scrim and the headline laid
 * over the bottom. Used for the homepage hero and for a desk's lead story.
 */
interface Props {
  post: Post;
  /**
   * Stretch to the height of the surrounding grid row instead of holding a
   * fixed aspect ratio. This is what keeps the homepage's hero and its side
   * rail level: both are columns of one grid row, so the hero fills whatever
   * height the rail needs, and the image crops to fit.
   *
   * The image is taken out of flow while filling. Left in flow it would impose
   * its own intrinsic height, and a portrait cover would then make the hero
   * taller than the rail, leaving the rail short of the shared bottom edge —
   * exactly the imbalance this is meant to avoid.
   */
  fill?: boolean;
  /** Overrides the frame classes; rarely needed. */
  frameClass?: string;
}

const {
  post,
  fill = false,
  frameClass = fill
    ? 'aspect-square sm:aspect-[16/11] lg:aspect-auto lg:h-full'
    : 'aspect-square sm:aspect-[16/11]',
} = Astro.props;
const author = authorBySlug.get(post.data.author);
---

<a
  href={`/post/${post.id}/`}
  class:list={['story-tile group relative block', fill && 'min-h-0 flex-1']}
>
  <div class:list={['story-frame settle relative', frameClass]}>
    <Image
      src={post.data.cover}
      widths={leadWidths}
      sizes={leadSizes}
      alt={post.data.coverAlt}
      loading="eager"
      decoding="async"
      class:list={['h-full w-full object-cover', fill && 'absolute inset-0']}
    />
    <div class="image-scrim" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 max-w-4xl p-5 md:p-8 lg:p-10">
      <CategoryChip category={post.data.category} onImage size="text-[11px]" />
      <h2
        class="mt-4 font-display text-[clamp(1.7rem,7vw,2.4rem)] leading-[1.02] font-extrabold text-balance text-white md:text-[clamp(2.1rem,4vw,3.35rem)]"
      >
        {post.data.title}
      </h2>
      <p class="mt-3 max-w-2xl text-pretty text-white/85 md:text-lg">{post.data.description}</p>
      <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-white/80">
        {author && <span>By {author.name}</span>}
        <span aria-hidden="true">/</span>
        <span class="font-mono text-xs">
          {formatDateShort(post.data.publishedAt)} / {readingTime(post)} min
        </span>
      </p>
    </div>
  </div>
</a>
