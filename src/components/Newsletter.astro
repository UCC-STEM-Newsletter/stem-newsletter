---
import { newsletter } from '../data/site';

/**
 * Newsletter capture block.
 *
 * The reference markup wraps an inner container in a bare `section.newsletter`,
 * which is what draws the tinted band and its top/bottom rules.
 */
interface Props {
  variant?: 'full' | 'compact';
  /** Anchor target, so `/#newsletter` links land on the band. */
  id?: string;
}

const { variant = 'full', id: sectionId } = Astro.props;

const inputId = variant === 'compact' ? 'newsletter-email-compact' : 'newsletter-email';
const headingId = `${inputId}-heading`;
---

<section id={sectionId} class="newsletter" aria-labelledby={headingId}>
  <div
    class:list={[
      'mx-auto max-w-xl px-6 text-center',
      variant === 'compact' ? 'py-10' : 'py-14 sm:py-16',
    ]}
  >
    <h2
      id={headingId}
      class:list={[
        'font-display leading-[1.08] font-extrabold text-balance',
        variant === 'compact' ? 'text-xl sm:text-2xl' : 'text-2xl sm:text-[1.75rem]',
      ]}
    >
      {newsletter.heading}
    </h2>
    <p class="mt-3 text-pretty text-sm leading-6 text-muted-foreground">{newsletter.body}</p>
    {/*
      TODO: point this at a real list before launch. It deliberately has no
      action, so submitting does nothing rather than posting into the void —
      add `action="https://..."` (Buttondown, Mailchimp, a Google Form) or
      replace the form with the provider's embed.
    */}
    <form class="mt-7 grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto]" method="post">
      <label class="sr-only" for={inputId}>Email address</label>
      <input
        id={inputId}
        required
        type="email"
        name="email"
        autocomplete="email"
        placeholder="you@example.com"
        class="newsletter-input"
      />
      <button type="submit" class="button-primary min-h-12 px-6 text-sm font-semibold">
        Subscribe
      </button>
    </form>
    <p class="mt-4 font-mono text-[11px] leading-5 text-muted-foreground">{newsletter.note}</p>
  </div>
</section>
