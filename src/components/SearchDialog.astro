---
import Icon from './Icon.astro';
import Lucide from './Lucide.astro';

/**
 * Search overlay. Results are rendered client-side from `/search-index.json`
 * by `src/scripts/search.ts`; the form falls back to the full search page.
 */
---

<div class="site-search-overlay" data-site-search-overlay hidden>
  <button
    type="button"
    class="site-search-overlay-backdrop"
    data-site-search-close
    tabindex="-1"
    aria-label="Close search"></button>
  <div
    id="site-search-dialog"
    class="site-search-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="site-search-dialog-title"
  >
    <div class="flex items-center justify-between gap-4 border-b border-border px-4 py-3 sm:px-5">
      <p id="site-search-dialog-title" class="eyebrow text-muted-foreground">Search Catalyst</p>
      <button
        type="button"
        class="site-search-close inline-grid h-9 w-9 place-items-center text-muted-foreground hover:text-foreground"
        data-site-search-close
        aria-label="Close search"
      >
        <Icon name="close" class="h-4 w-4" />
      </button>
    </div>
    <form action="/search/" method="get" role="search" class="site-search" data-site-search-form>
      <label for="site-search-dialog-input" class="sr-only">Search Catalyst stories</label>
      <div class="site-search-field site-search-dialog-field">
        <Lucide name="search" class="h-5 w-5 text-muted-foreground" />
        <input
          id="site-search-dialog-input"
          name="q"
          type="search"
          autocomplete="off"
          enterkeyhint="search"
          placeholder="Search stories, topics, authors..."
          class="site-search-input"
          aria-controls="site-search-dialog-results"
          aria-expanded="false"
          data-site-search-input
        />
      </div>
      <div
        id="site-search-dialog-results"
        class="site-search-panel site-search-dialog-panel"
        data-site-search-panel
        hidden
      >
      </div>
    </form>
  </div>
</div>
