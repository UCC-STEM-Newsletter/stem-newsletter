---
import type { Category } from '../data/categories';
import { contribute } from '../data/site';

/**
 * Off-canvas navigation for narrow viewports.
 *
 * Deliberately just navigation and the site's one call to action: with a small
 * archive, a "popular now" rail in here would only repeat the newest stories a
 * reader has already scrolled past.
 */
interface Props {
  categories: Pick<Category, 'slug' | 'name'>[];
}

const { categories } = Astro.props;
const activeCategory = Astro.url.pathname.match(/^\/category\/([^/]+)\//)?.[1];
---

<div id="mobile-menu-panel" class="mobile-menu-panel" hidden>
  <div class="flex min-w-0 flex-col gap-7 px-5 py-5 sm:px-6">
    <div class="flex items-center justify-between gap-6">
      <a
        href="/"
        class="font-display text-3xl leading-none font-extrabold tracking-[-0.045em]"
        aria-label="Catalyst home">Catalyst</a
      >
      <button
        type="button"
        class="mobile-menu-close grid h-10 w-10 shrink-0 place-items-center border border-border-strong"
        data-mobile-menu-close
        aria-label="Close navigation menu"
      >
        <span class="icon h-5 w-5" style="--icon: url('/icons/close.svg')" aria-hidden="true"></span>
      </button>
    </div>

    <nav aria-label="Mobile navigation">
      <ul class="grid gap-1">
        {
          categories.map((category) => (
            <li>
              <a
                href={`/category/${category.slug}/`}
                class:list={[
                  'block border-b border-border py-3 font-display text-3xl font-bold leading-none',
                  category.slug === activeCategory ? 'text-primary' : 'text-foreground',
                ]}
              >
                {category.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Publication pages">
      <p class="eyebrow mb-3 text-muted-foreground">Pages</p>
      <ul class="grid gap-2.5 text-sm">
        <li><a href="/all-news/" class="story-link">All stories</a></li>
        <li><a href="/authors/" class="story-link">Contributors</a></li>
        <li><a href="/about/" class="story-link">About</a></li>
        <li><a href="/contact/" class="story-link">Contact</a></li>
      </ul>
    </nav>

    <div class="grid gap-3 pb-4">
      <a
        href={contribute.cta.href}
        class="button-primary min-h-11 px-4 py-3 text-center text-sm font-semibold"
      >
        {contribute.cta.label}
      </a>
    </div>
  </div>
</div>
