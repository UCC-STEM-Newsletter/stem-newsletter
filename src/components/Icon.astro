---
/**
 * Monochrome icon rendered through a CSS mask so it inherits `currentColor`.
 * Assets live in `public/icons`.
 */
interface Props {
  name: string;
  class?: string;
}

import { withBase } from '../lib/url';

const { name, class: className = 'h-4 w-4' } = Astro.props;
---

<span
  class={`icon ${className}`}
  style={`--icon: url('${withBase(`/icons/${name}.svg`)}')`}
  aria-hidden="true"
></span>
