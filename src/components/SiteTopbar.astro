---
import { contribute, site } from '../data/site';
import { categories } from '../data/categories';
import Icon from './Icon.astro';
import Lucide from './Lucide.astro';

/**
 * Sticky masthead: utility strip and brand row with primary navigation.
 * The search dialog and mobile drawer are rendered as siblings immediately
 * after this element.
 */
const activeCategory = Astro.url.pathname.match(/^\/category\/([^/]+)\//)?.[1];
---

<header class="site-topbar sticky top-0 z-40 border-b border-border bg-surface" data-site-topbar>
  <div class="border-b border-border/70 text-[11px] text-muted-foreground">
    <div
      class="mx-auto flex h-9 max-w-7xl items-center justify-between px-5 font-mono uppercase tracking-[0.2em] sm:px-6 lg:px-10"
    >
      <span class="hidden sm:inline">{site.tagline}</span>
      <div class="flex items-center gap-4">
        <a href="/all-news/" class="hover:text-foreground">Archive</a>
        <button
          type="button"
          class="theme-toggle inline-grid place-items-center hover:text-foreground"
          data-theme-toggle
          aria-label="Switch color theme"
        >
          <Lucide name="sun" class="h-3.5 w-3.5" />
          <Lucide name="moon" class="h-3.5 w-3.5" />
        </button>
      </div>
    </div>
  </div>

  <div
    class="site-header-main mx-auto flex min-h-18 max-w-7xl items-center justify-between gap-5 px-5 py-4 sm:px-6 lg:px-10"
  >
    <div class="flex items-center gap-3">
      <button
        type="button"
        class="mobile-menu-toggle grid h-10 w-10 cursor-pointer place-items-center bg-transparent"
        aria-controls="mobile-menu-panel"
        aria-expanded="false"
        data-mobile-menu-toggle
        aria-label="Open navigation menu"
      >
        <span class="mobile-menu-label-open" aria-hidden="true">
          <Icon name="menu" class="h-5 w-5" />
        </span>
        <span class="mobile-menu-label-close" aria-hidden="true">
          <Icon name="close" class="h-5 w-5" />
        </span>
        <span class="sr-only">Open navigation menu</span>
      </button>
      <a
        href="/"
        class="font-display text-3xl leading-none font-extrabold tracking-[-0.045em] sm:text-4xl"
        aria-label="Catalyst home">Catalyst</a
      >
    </div>

    <div class="compact-header-actions flex items-center gap-2 xl:hidden">
      <a
        href="/search/"
        class="site-search-toggle"
        aria-controls="site-search-dialog"
        aria-expanded="false"
        data-site-search-toggle
        aria-label="Search Catalyst stories"
      >
        <Lucide name="search" class="h-4 w-4 text-muted-foreground" />
      </a>
    </div>

    <nav
      class="primary-navigation hidden items-center gap-6 text-sm font-semibold xl:flex"
      aria-label="Primary navigation"
    >
      {
        categories.map((category) => (
          <a
            href={`/category/${category.slug}/`}
            class:list={[
              'story-link text-foreground/80 hover:text-foreground',
              category.slug === activeCategory && 'text-primary',
            ]}
          >
            {category.name}
          </a>
        ))
      }
    </nav>

    <div class="desktop-header-actions hidden items-center gap-2 xl:flex">
      <div class="site-search-desktop">
        <a
          href="/search/"
          class="site-search-toggle"
          aria-controls="site-search-dialog"
          aria-expanded="false"
          data-site-search-toggle
        >
          <Lucide name="search" class="h-4 w-4 text-muted-foreground" />
          <span class="sr-only">Search Catalyst stories</span>
        </a>
      </div>
      <a
        href={contribute.cta.href}
        class="button-primary inline-flex min-h-10 items-center px-4 text-sm font-semibold"
      >
        {contribute.shortLabel}
      </a>
    </div>
  </div>
</header>
