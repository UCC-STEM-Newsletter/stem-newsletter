---
import type { Post } from '../lib/posts';
import type { DeskLayout } from '../data/homepage';
import { categoryBySlug } from '../data/categories';
import StoryFeature from './StoryFeature.astro';
import StoryMini from './StoryMini.astro';
import StoryTile from './StoryTile.astro';

/**
 * A desk's homepage block.
 *
 * `spotlight` pairs one large lead with a stacked rail; `grid-3` and `grid-4`
 * lay every story out as an equal card.
 */
interface Props {
  category: string;
  layout: DeskLayout;
  /** Stories to render, already limited to the layout capacity. */
  posts: Post[];
  /** Total stories in the desk, used for the "05 stories" note. */
  total: number;
}

const { category, layout, posts, total } = Astro.props;
const meta = categoryBySlug.get(category);
const name = meta?.name ?? category;
const description = meta?.description ?? '';
const count = String(total).padStart(2, '0');

const gridClass =
  layout === 'grid-4'
    ? 'grid-cards col-rules-2-4 grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-4'
    : 'grid-cards col-rules-3 grid gap-x-8 gap-y-10 md:grid-cols-3';

const feature = posts[0];
const rest = posts.slice(1);
---

<section class="mx-auto max-w-7xl px-5 pt-20 sm:px-6 lg:px-10">
  <div id={category} class="mb-7 scroll-mt-32">
    <div class="section-rule rule-top"></div>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
      <div class="max-w-xl">
        <h2 class="font-display text-3xl leading-[0.98] font-extrabold text-balance md:text-[2.6rem]">
          {name}
        </h2>
        <p class="mt-2.5 text-pretty text-sm leading-6 text-muted-foreground">{description}</p>
      </div>
      <div class="flex items-center gap-4">
        <span class="eyebrow hidden text-muted-foreground sm:inline">{count} stories</span>
        <a
          href={`/category/${category}/`}
          class="button-quiet inline-flex min-h-9 items-center px-3.5 font-mono text-[10px] font-semibold tracking-[0.22em] uppercase"
        >
          See all
        </a>
      </div>
    </div>
  </div>

  {
    layout === 'spotlight' && feature ? (
      <div class="grid-cards grid gap-x-8 gap-y-8 lg:grid-cols-[1.15fr_0.85fr]">
        <StoryFeature post={feature} />
        <div class="lg:border-l lg:border-border lg:pl-8">
          {rest.map((post) => (
            <StoryMini post={post} />
          ))}
        </div>
      </div>
    ) : (
      <div class={gridClass}>
        {posts.map((post) => (
          <StoryTile post={post} />
        ))}
      </div>
    )
  }
</section>
