---
import type { Post } from '../lib/posts';
import { categoryBySlug } from '../data/categories';
import StoryFeature from './StoryFeature.astro';
import StoryMini from './StoryMini.astro';
import StoryTile from './StoryTile.astro';

/**
 * A desk's homepage block.
 *
 * The layout is chosen from how many stories the desk actually has, so a new
 * desk looks deliberate at two stories and expands into a spotlight once it has
 * enough for one. Desks below the composition's minimum are not rendered at
 * all — the page decides that, not this component.
 */
interface Props {
  category: string;
  /** Every story in the desk, used for the count note and the layout choice. */
  posts: Post[];
}

const { category, posts } = Astro.props;
const meta = categoryBySlug.get(category);
const name = meta?.name ?? category;
const total = posts.length;
const count = String(total).padStart(2, '0');

// Five or more earns a spotlight: one feature plus a stacked rail.
const spotlight = total >= 5;
const feature = posts[0];
const rest = posts.slice(1);

// Pick the column count that fills whole rows: 2 and 4 go two-up (4 becomes
// four-up on wide screens), 3 goes three-up. Nothing is left orphaned on a row
// of its own, and five or more earns the spotlight above instead.
const gridClass =
  total === 4
    ? 'grid-cards col-rules-2-4 grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-4'
    : total === 3
      ? 'grid-cards col-rules-3 grid gap-x-8 gap-y-10 md:grid-cols-3'
      : 'grid-cards col-rules-2 grid gap-x-8 gap-y-10 md:grid-cols-2';
---

<section class="mx-auto max-w-7xl px-5 pt-20 sm:px-6 lg:px-10">
  <div id={category} class="mb-7 scroll-mt-32">
    <div class="section-rule rule-top"></div>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
      <div class="max-w-xl">
        <h2 class="font-display text-3xl leading-[0.98] font-extrabold text-balance md:text-[2.6rem]">
          {name}
        </h2>
        <p class="mt-2.5 text-pretty text-sm leading-6 text-muted-foreground">
          {meta?.description}
        </p>
      </div>
      <div class="flex items-center gap-4">
        <span class="eyebrow hidden text-muted-foreground sm:inline">{count} stories</span>
        <a
          href={`/category/${category}/`}
          class="button-quiet inline-flex min-h-9 items-center px-3.5 font-mono text-[10px] font-semibold tracking-[0.22em] uppercase"
        >
          See all
        </a>
      </div>
    </div>
  </div>

  {
    spotlight && feature ? (
      <div class="grid-cards grid gap-x-8 gap-y-8 lg:grid-cols-[1.15fr_0.85fr]">
        <StoryFeature post={feature} />
        <div class="lg:border-l lg:border-border lg:pl-8">
          {rest.slice(0, 4).map((post) => (
            <StoryMini post={post} />
          ))}
        </div>
      </div>
    ) : (
      <div class={gridClass}>
        {posts.map((post) => (
          <StoryTile post={post} />
        ))}
      </div>
    )
  }
</section>
