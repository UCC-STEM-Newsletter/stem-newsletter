---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const sections = [
  {
    heading: 'Information You Collect',
    body: 'The site may collect newsletter email addresses, contact messages, analytics events, and advertising-related data when those features are enabled.',
  },
  {
    heading: 'How You Use It',
    body: 'Collected data may be used for publishing, responding to inquiries, sending email, measuring traffic, improving content, and complying with legal obligations.',
  },
];
---

<BaseLayout title={`Privacy Policy | ${site.name}`} description="Privacy policy for Catalyst.">
  <section class="mx-auto max-w-4xl px-6 pt-12 lg:px-10">
    <p class="eyebrow text-primary">Privacy</p>
    <h1 class="mt-3 font-display text-5xl leading-[0.95] font-extrabold md:text-7xl">
      Privacy Policy
    </h1>
    <p class="mt-6 max-w-2xl text-pretty text-xl text-muted-foreground">
      This page explains the types of information a publication may collect, how that information
      can be used, and how readers can get in touch about privacy requests.
    </p>
  </section>

  <section class="mx-auto grid max-w-4xl gap-8 px-6 pt-14 text-muted-foreground lg:px-10">
    {
      sections.map((section) => (
        <div>
          <h2 class="font-display text-3xl font-bold text-foreground">{section.heading}</h2>
          <p class="mt-4 leading-7">{section.body}</p>
        </div>
      ))
    }
    <div>
      <h2 class="font-display text-3xl font-bold text-foreground">Contact</h2>
      <p class="mt-4 leading-7">
        For privacy requests, contact <a
          class="story-link text-primary"
          href={`mailto:${site.editorialEmail}`}>{site.editorialEmail}</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>
