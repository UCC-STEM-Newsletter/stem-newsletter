---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const cards = [
  {
    heading: 'Editorial',
    body: 'Send story ideas, corrections, and publication questions.',
    link: { label: site.editorialEmail, href: `mailto:${site.editorialEmail}` },
  },
  {
    heading: 'Advertising',
    body: 'Ask about sponsorships, display placements, newsletter inventory, and editorial partnerships.',
    link: {
      label: 'Advertise with us',
      href: `mailto:${site.editorialEmail}?subject=Advertising inquiry`,
    },
  },
];
---

<BaseLayout
  title={`Contact | ${site.name}`}
  description="Contact Semnal for editorial, advertising, partnerships, and general publication inquiries."
>
  <section class="mx-auto max-w-4xl px-6 pt-12 lg:px-10">
    <p class="eyebrow text-primary">Contact</p>
    <h1 class="mt-3 font-display text-5xl leading-[0.95] font-extrabold md:text-7xl">
      Get in touch
    </h1>
    <p class="mt-6 max-w-2xl text-pretty text-xl text-muted-foreground">
      Use this page for editorial tips, partnerships, advertising, and general publication
      inquiries.
    </p>
  </section>

  <section class="mx-auto grid max-w-4xl gap-6 px-6 pt-14 md:grid-cols-2 lg:px-10">
    {
      cards.map((card) => (
        <article class="border border-border bg-card p-6">
          <h2 class="font-display text-2xl font-bold">{card.heading}</h2>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">{card.body}</p>
          <a class="story-link mt-5 inline-block text-sm text-primary" href={card.link.href}>
            {card.link.label}
          </a>
        </article>
      ))
    }
  </section>
</BaseLayout>
