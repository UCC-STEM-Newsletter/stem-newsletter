---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contribute, site } from '../data/site';

const cards = [
  {
    heading: 'Editorial',
    body: 'Corrections, questions about something we published, or a tip you would rather not write up yourself.',
    link: { label: site.editorialEmail, href: `mailto:${site.editorialEmail}` },
  },
  {
    heading: 'Contribute',
    body: 'Pitch a project, a piece of research, or a question worth chasing. No writing experience needed.',
    link: { label: contribute.cta.label, href: contribute.cta.href },
  },
];
---

<BaseLayout
  title={`Contact | ${site.name}`}
  description="Contact the Catalyst editors with corrections, questions, or a story idea."
>
  <section class="mx-auto max-w-4xl px-6 pt-12 lg:px-10">
    <p class="eyebrow text-primary">Contact</p>
    <h1 class="mt-3 font-display text-5xl leading-[0.95] font-extrabold md:text-7xl">
      Get in touch
    </h1>
    <p class="mt-6 max-w-2xl text-pretty text-xl text-muted-foreground">
      Corrections, questions, and story ideas all land in the same inbox, and a person reads every
      one.
    </p>
  </section>

  <section class="mx-auto grid max-w-4xl gap-6 px-6 pt-14 md:grid-cols-2 lg:px-10">
    {
      cards.map((card) => (
        <article class="border border-border bg-card p-6">
          <h2 class="font-display text-2xl font-bold">{card.heading}</h2>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">{card.body}</p>
          <a class="story-link mt-5 inline-block text-sm text-primary" href={card.link.href}>
            {card.link.label}
          </a>
        </article>
      ))
    }
  </section>
</BaseLayout>
