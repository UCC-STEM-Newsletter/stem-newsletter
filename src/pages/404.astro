---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { categories } from '../data/categories';
---

<BaseLayout
  title={`Page not found | ${site.name}`}
  description="The page you were looking for is not on Semnal."
>
  <section class="mx-auto max-w-4xl px-6 pt-12 lg:px-10">
    <p class="eyebrow text-primary">Error 404</p>
    <h1 class="mt-3 font-display text-5xl leading-[0.95] font-extrabold md:text-7xl">
      Story not found
    </h1>
    <p class="mt-6 max-w-2xl text-pretty text-xl text-muted-foreground">
      That link has moved or never existed. Try the archive, or jump straight to a desk.
    </p>
    <div class="mt-8 flex flex-wrap gap-2">
      <a
        href="/all-news/"
        class="button-primary inline-flex min-h-10 items-center px-4 text-sm font-semibold">All news</a
      >
      <a
        href="/search/"
        class="button-quiet inline-flex min-h-10 items-center px-4 text-sm font-semibold">Search</a
      >
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pt-14 lg:px-10">
    <div class="section-rule rule-top"></div>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((category) => (
          <li>
            <a
              href={`/category/${category.slug}/`}
              class="story-link font-display text-xl font-bold"
            >
              {category.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
