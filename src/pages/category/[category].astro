---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryOverlay from '../../components/StoryOverlay.astro';
import StoryMini from '../../components/StoryMini.astro';
import StoryTile from '../../components/StoryTile.astro';
import Newsletter from '../../components/Newsletter.astro';
import { site } from '../../data/site';
import { categories, categoryBySlug } from '../../data/categories';
import { allPosts, postsByCategory } from '../../lib/posts';
import { pluralize } from '../../lib/format';

/** A desk's front page: `/category/ai-frontier/` … */

export const getStaticPaths = (async () => {
  const posts = await allPosts();

  return categories.map((category) => {
    const categoryPosts = postsByCategory(posts, category.slug);
    // "Across the site" is simply the newest stories from the other desks.
    const across = posts
      .filter((post) => post.data.category !== category.slug)
      .slice(0, 5);

    return {
      params: { category: category.slug },
      props: { category: category.slug, posts: categoryPosts, across },
    };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { category, posts, across } = Astro.props;
const meta = categoryBySlug.get(category);
const name = meta?.name ?? category;
const [lead, ...rest] = posts;
---

<BaseLayout
  title={`${name} stories | ${site.name}`}
  description={`Catalyst ${name} coverage: reporting, explainers, and student research.`}
>
  <section class="mx-auto max-w-7xl px-6 pt-12 lg:px-10">
    <div class="opener rule-top border-b border-border pt-4 pb-7">
      <div>
        <p class="eyebrow text-primary">Category</p>
        <h1 class="mt-2 font-display text-5xl leading-[0.95] font-extrabold md:text-6xl">
          {name}
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-lg leading-relaxed text-muted-foreground">
          {meta?.description}
        </p>
        <p class="eyebrow mt-4 text-muted-foreground">
          {posts.length === 0
            ? 'Nothing published yet'
            : `${pluralize(posts.length, 'story')}, newest first`}
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pt-10 lg:px-10">
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-[1fr_340px]">
      <div class="opener space-y-10">
        {
          !lead && (
            <div class="border border-border bg-card p-6">
              <h2 class="font-display text-2xl font-bold">No {name} stories yet</h2>
              <p class="mt-2 text-muted-foreground">
                This desk is open but nothing has been filed to it yet. In the meantime, the
                rest of the archive is worth a look.
              </p>
              <a
                href="/all-news/"
                class="button-quiet mt-5 inline-flex min-h-10 items-center px-4 text-sm font-semibold"
              >
                Browse all stories
              </a>
            </div>
          )
        }
        {lead && <StoryOverlay post={lead} />}
        {
          rest.length > 0 && (
            <div class="grid-cards col-rules-2 grid gap-x-8 gap-y-10 md:grid-cols-2">
              {rest.map((post) => (
                <StoryTile post={post} />
              ))}
            </div>
          )
        }
      </div>

      <aside
        class:list={['lg:border-l lg:border-border lg:pl-8', !lead && 'hidden lg:block']}
        aria-labelledby="across-site-heading"
      >
        <div class="article-rail sticky">
          <div class="rule-top mb-1 flex items-baseline justify-between gap-4 pt-3">
            <h2 id="across-site-heading" class="font-display text-xl font-extrabold">
              Across the site
            </h2>
            <span class="eyebrow text-primary animate-pulse-dot">Live</span>
          </div>
          {across.map((post) => <StoryMini post={post} />)}
        </div>
      </aside>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pt-24 lg:px-10">
    <Newsletter />
  </section>
</BaseLayout>
