---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StoryOverlay from '../components/StoryOverlay.astro';
import StoryTile from '../components/StoryTile.astro';
import StoryMini from '../components/StoryMini.astro';
import StoryRank from '../components/StoryRank.astro';
import DeskSection from '../components/DeskSection.astro';
import Newsletter from '../components/Newsletter.astro';
import { site, deskIndex } from '../data/site';
import { home, editorialBriefing, deskCapacity } from '../data/homepage';
import { categories } from '../data/categories';
import { tags } from '../data/tags';
import { allPosts, pickPosts, postsByCategory, fillPosts } from '../lib/posts';
import { formatDateShort } from '../lib/format';
import { accentClass } from '../lib/accent';

const posts = await allPosts();

// --- top of the page ---------------------------------------------------
// A curated lead, a two-up rail, the "Latest" column and the "Most read"
// chart together consume the newest stories; everything after that is either
// a desk block or the closing catch-all grid.
const lead = pickPosts(posts, [home.lead], 1)[0] ?? posts[0];
const secondary = fillPosts(posts, pickPosts(posts, home.secondary), 4, new Set([lead.id]));
const latest = fillPosts(
  posts,
  pickPosts(posts, home.latest),
  5,
  new Set([lead.id, ...secondary.map((post) => post.id)]),
);
const usedAbove = new Set([lead.id, ...secondary.map((p) => p.id), ...latest.map((p) => p.id)]);
const mostRead = fillPosts(posts, pickPosts(posts, home.mostRead), 6, usedAbove);

/** How many stories the four blocks above consume from the top of the feed. */
const topCount = 1 + secondary.length + latest.length + mostRead.length;
const more = posts.slice(topCount, topCount + home.moreLimit);

const topics = tags.slice(0, home.topicLimit);

// --- desk blocks -------------------------------------------------------
const desks = home.desks.map((desk) => {
  const all = postsByCategory(posts, desk.category);
  return {
    category: desk.category,
    layout: desk.layout,
    total: all.length,
    posts: all.slice(0, deskCapacity[desk.layout]),
  };
});

// The front page runs the desk index after the first desk block and the
// newsletter before the final three, matching the reference layout.
const [firstDesk, ...middleDesks] = desks;
const tailDesks = middleDesks.slice(2);

const deskIndexRows = categories.map((category) => {
  const categoryPosts = postsByCategory(posts, category.slug);
  return {
    category,
    count: String(categoryPosts.length).padStart(2, '0'),
    lead: categoryPosts[0],
  };
});
---

<BaseLayout title={site.title} description={site.description} image="/og-image.png">
  <h1 class="sr-only">{site.title}</h1>

  <section class="mx-auto max-w-7xl px-5 pt-8 sm:px-6 lg:px-10">
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-[minmax(0,1fr)_340px]">
      <div class="opener space-y-10">
        <StoryOverlay post={lead} />
        <div class="col-rules-2 grid gap-x-8 gap-y-10 md:grid-cols-2">
          {secondary.map((post) => <StoryTile post={post} loading="eager" />)}
        </div>
      </div>

      <div class="opener space-y-10 lg:border-l lg:border-border lg:pl-8">
        <aside>
          <div class="rule-top pt-3">
            <div class="mb-1 flex items-baseline justify-between gap-4">
              <h2 class="font-display text-xl font-extrabold">Latest</h2>
              <span class="eyebrow text-primary animate-pulse-dot">Live</span>
            </div>
            {latest.map((post) => <StoryMini post={post} />)}
          </div>
        </aside>

        <aside class="rule-top flex flex-col pt-3">
          <p class="eyebrow text-primary">{editorialBriefing.eyebrow}</p>
          <p class="mt-3 font-display text-xl leading-[1.1] font-bold text-balance">
            {editorialBriefing.heading}
          </p>
          <p class="mt-3 text-pretty text-sm leading-6 text-muted-foreground">
            {editorialBriefing.body}
          </p>
          <a
            href={editorialBriefing.cta.href}
            class="button-primary mt-5 inline-flex min-h-11 items-center justify-center px-5 text-sm font-semibold"
          >
            {editorialBriefing.cta.label}
          </a>
        </aside>

        <nav class="rule-top pt-3" aria-labelledby="home-topics-heading">
          <p id="home-topics-heading" class="eyebrow text-muted-foreground">Topics in play</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              topics.map((tag) => (
                <li>
                  <a
                    href={`/tag/${tag.slug}/`}
                    class="button-quiet inline-flex min-h-8 items-center px-2.5 font-mono text-[10px] tracking-[0.16em] uppercase"
                  >
                    {tag.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </section>

  <div class="reveal pt-20">
    <section class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-10" aria-labelledby="popular-heading">
      <SectionHeading
        heading="Most read"
        blurb="What the newsroom's readers opened most in the last seven days."
        headingId="popular-heading"
        actionLabel="View archive"
        actionHref="/all-news/"
      />
      <div class="grid-cards col-rules-3 grid gap-x-8 md:grid-cols-3">
        {mostRead.map((post, index) => <StoryRank post={post} index={index} />)}
      </div>
    </section>
  </div>

  <DeskSection {...firstDesk} />

  <div class="reveal pt-20">
    <section class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-10" aria-labelledby="desk-index-heading">
      <SectionHeading
        heading={deskIndex.heading}
        blurb={deskIndex.blurb}
        headingId="desk-index-heading"
        actionLabel="Full archive"
        actionHref="/all-news/"
      />
      <ul class="grid-cards col-rules-3 grid gap-x-8 md:grid-cols-3">
        {
          deskIndexRows.map((row) => (
            <li class="border-t border-border py-4">
              <div class="flex items-baseline justify-between gap-3">
                <a
                  href={`/category/${row.category.slug}/`}
                  class={`eyebrow story-link ${accentClass(row.category.accent)}`}
                >
                  {row.category.name}
                </a>
                <span class="font-mono text-[11px] text-muted-foreground">{row.count}</span>
              </div>
              {row.lead && (
                <a href={`/post/${row.lead.id}/`} class="story-tile group mt-2.5 block">
                  <p class="story-headline font-display text-base leading-[1.16] font-bold text-balance">
                    {row.lead.data.title}
                  </p>
                  <p class="mt-2 font-mono text-[11px] text-muted-foreground">
                    {formatDateShort(row.lead.data.publishedAt)}
                  </p>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  {middleDesks.slice(0, 2).map((desk) => <DeskSection {...desk} />)}

  {/* The reference layout keeps an empty spacer section here; it carries the
      6rem gap that separates the desk blocks from the newsletter band. */}
  <section class="reveal mt-24"></section>
  <Newsletter id="newsletter" />

  {tailDesks.map((desk) => <DeskSection {...desk} />)}

  <section class="mx-auto max-w-7xl px-5 pt-20 sm:px-6 lg:px-10">
    <SectionHeading
      heading="More from the newsroom"
      blurb="Everything else the desks filed, newest first."
      actionLabel="All news"
      actionHref="/all-news/"
    />
    <div class="mb-9 flex flex-wrap gap-2">
      {
        categories.map((category) => (
          <a
            href={`/category/${category.slug}/`}
            class="button-quiet inline-flex min-h-8 items-center px-3 font-mono text-[10px] tracking-[0.18em] uppercase"
          >
            {category.name}
          </a>
        ))
      }
    </div>
    <div class="grid-cards col-rules-2-4 grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-4">
      {more.map((post) => <StoryTile post={post} />)}
    </div>
  </section>
</BaseLayout>
