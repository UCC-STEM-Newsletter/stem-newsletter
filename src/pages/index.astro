---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StoryOverlay from '../components/StoryOverlay.astro';
import StoryMini from '../components/StoryMini.astro';
import StoryTile from '../components/StoryTile.astro';
import StoryRank from '../components/StoryRank.astro';
import DeskSection from '../components/DeskSection.astro';
import Contribute from '../components/Contribute.astro';
import { site } from '../data/site';
import { compositionFor, picks, PICKS_MINIMUM } from '../data/homepage';
import { categories } from '../data/categories';
import { allPosts, leadPost, pickPosts, postsByCategory, takeUnused } from '../lib/posts';

const posts = await allPosts();

// How much front page the archive can fill. Everything below clamps to what
// actually exists, so the same code serves six stories and two hundred.
const plan = compositionFor(posts.length);

// `used` accumulates as blocks claim stories, so nothing appears twice in the
// same part of the page.
const used = new Set<string>();

const lead = leadPost(posts);
if (lead) used.add(lead.id);

const latest = plan.splitBand ? takeUnused(posts, plan.latest, used) : [];
for (const post of latest) used.add(post.id);

// A curated list minus anything already shown above, trimmed to whole rows of
// the three-column grid so the chart never ends on a single orphan card.
// Skipped entirely when too few picks survive.
const availablePicks = pickPosts(posts, picks).filter((post) => !used.has(post.id));
const picksThatFit = Math.floor(Math.min(availablePicks.length, plan.picks) / 3) * 3;
const picked = availablePicks.slice(0, picksThatFit);
const showPicks = picked.length >= PICKS_MINIMUM;
if (showPicks) for (const post of picked) used.add(post.id);

// A desk needs a couple of stories before it earns a section of its own.
const desks = categories
  .map((category) => ({ category: category.slug, posts: postsByCategory(posts, category.slug) }))
  .filter((desk) => desk.posts.length >= plan.deskMinimum);

const remaining = posts.filter((post) => !used.has(post.id));
// Tier A has to show everything left, so it takes a ragged final row if that is
// what the archive gives. From tier B the closing grid is a sampler, so it is
// trimmed to whole rows of three.
const closingFits =
  plan.closing === 0
    ? remaining.length
    : Math.floor(Math.min(remaining.length, plan.closing) / 3) * 3;
const closing = remaining.slice(0, closingFits);
const showClosing = plan.closing === 0 ? closingFits > 0 : closingFits >= 3;

// With a split band the lead region is two columns of a single grid row.
// Because grid items stretch, the hero fills whatever height the rail needs, so
// the two columns end at the same edge without either side being tuned to fit.
const split = plan.splitBand && latest.length > 0;
---

<BaseLayout title={site.title} description={site.description} image="/og-image.png">
  <h1 class="sr-only">{site.title}</h1>

  <section class="mx-auto max-w-7xl px-5 pt-8 sm:px-6 lg:px-10">
    <div
      class:list={[
        'opener grid gap-x-8',
        // Three columns, with the hero across the first two. That is the same
        // spine every grid below uses, so the divider between the hero and the
        // rail falls on their second hairline rather than at a position of its
        // own.
        split ? 'col-rules-split gap-y-12 lg:grid-cols-3' : 'gap-y-0',
      ]}
    >
      <div class="flex min-w-0 flex-col lg:col-span-2">
        {lead && <StoryOverlay post={lead} fill={split} />}
      </div>

      {
        split && (
          <div class="flex flex-col">
            <div class="rule-top pt-3">
              <div class="mb-1 flex items-baseline justify-between gap-4">
                <h2 class="font-display text-xl font-extrabold">Latest</h2>
                <span class="eyebrow text-primary animate-pulse-dot">Live</span>
              </div>
              {latest.map((post) => (
                <StoryMini post={post} />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  {
    showPicks && (
      <div class="reveal pt-14">
        <section class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-10" aria-labelledby="picks-heading">
          <SectionHeading
            heading="Editor's picks"
            blurb="Stories the desk keeps coming back to, chosen by the editors."
            headingId="picks-heading"
            actionLabel="Full archive"
            actionHref="/all-news/"
          />
          <div class="grid-cards col-rules-3 grid gap-x-8 gap-y-8 md:grid-cols-3">
            {picked.map((post, index) => (
              <StoryRank post={post} index={index} />
            ))}
          </div>
        </section>
      </div>
    )
  }

  {desks.map((desk) => <DeskSection category={desk.category} posts={desk.posts} />)}

  <section class="reveal mt-24"></section>
  <Contribute />

  {
    showClosing && (
      <section class="mx-auto max-w-7xl px-5 pt-20 sm:px-6 lg:px-10">
        <SectionHeading
          heading={plan.tier === 'A' ? 'All stories' : 'More from the desks'}
          blurb="Everything else we have published, newest first."
          actionLabel="Archive"
          actionHref="/all-news/"
        />
        <div class="mb-9 flex flex-wrap gap-2">
          {categories.map((category) => (
            <a
              href={`/category/${category.slug}/`}
              class="button-quiet inline-flex min-h-8 items-center px-3 font-mono text-[10px] tracking-[0.18em] uppercase"
            >
              {category.name}
            </a>
          ))}
        </div>
        <div class="grid-cards col-rules-3 grid gap-x-8 gap-y-10 md:grid-cols-3">
          {closing.map((post) => (
            <StoryTile post={post} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
